    "Gemini Vision (OCR)": { "main": [[{ "node": "OCR JSON'u parse", "type": "main", "index": 0 }]] },
    "OCR JSON'u parse": { "main": [[{ "node": "Panel: Gider oluştur", "type": "main", "index": 0 }]] },
    "Panel: Gider oluştur": { "main": [[{ "node": "Fotoyu yeniden indir", "type": "main", "index": 0 }]] },
