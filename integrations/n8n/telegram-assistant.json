    "Panel: Fişi ekle": { "main": [[{ "node": "Telegram: Onay mesajı", "type": "main", "index": 0 }]] },
    "Gemini: Intent tespiti": { "main": [[{ "node": "Intent parse", "type": "main", "index": 0 }]] },
    "Intent parse": { "main": [[{ "node": "Intent router", "type": "main", "index": 0 }]] },
    "Intent router": {
      "main": [
        [{ "node": "Panel: Bugün", "type": "main", "index": 0 }],
        [{ "node": "Panel: Düşük stok", "type": "main", "index": 0 }],
        [{ "node": "Panel: Top ürünler", "type": "main", "index": 0 }],
        [{ "node": "Panel: Satış aralığı", "type": "main", "index": 0 }],
        [{ "node": "Panel: Kasa", "type": "main", "index": 0 }],
        [{ "node": "Telegram: Yardım", "type": "main", "index": 0 }]
      ]
    },
    "Panel: Bugün":         { "main": [[{ "node": "Gemini: Cevabı yaz", "type": "main", "index": 0 }]] },
    "Panel: Düşük stok":    { "main": [[{ "node": "Gemini: Cevabı yaz", "type": "main", "index": 0 }]] },
    "Panel: Top ürünler":   { "main": [[{ "node": "Gemini: Cevabı yaz", "type": "main", "index": 0 }]] },
    "Panel: Satış aralığı": { "main": [[{ "node": "Gemini: Cevabı yaz", "type": "main", "index": 0 }]] },
    "Panel: Kasa":          { "main": [[{ "node": "Gemini: Cevabı yaz", "type": "main", "index": 0 }]] },
    "Gemini: Cevabı yaz":   { "main": [[{ "node": "Mesaj metnini al", "type": "main", "index": 0 }]] },
    "Mesaj metnini al":     { "main": [[{ "node": "Telegram: Rapor cevabı", "type": "main", "index": 0 }]] },
    "Sabah 09:00 cron":     { "main": [[{ "node": "Sabah: Bugün özeti", "type": "main", "index": 0 }]] },
    "Sabah: Bugün özeti":   { "main": [[{ "node": "Sabah: Düşük stok", "type": "main", "index": 0 }]] },
    "Sabah: Düşük stok":    { "main": [[{ "node": "Sabah: Gemini brifing", "type": "main", "index": 0 }]] },
