# ─────────────────────────────────────────────────────────────────────────────
# DSDST Panel — Environment Variables
# Copy this file to .env and fill in the values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# JWT signing secret. Min 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_min_32_chars

# AES-256-GCM key used to encrypt third-party API keys at rest.
# Min 32 random characters.
# Generate the same way as JWT_SECRET.
ENCRYPTION_SECRET=CHANGE_ME_32_chars

# HMAC secret used to hash Panel API keys before storing.
# Use a different value from ENCRYPTION_SECRET.
PANEL_API_HASH_SECRET=CHANGE_ME_panel_hash_secret

# Web Push / VAPID. Generate one key pair with:
#   npx web-push generate-vapid-keys
# The public key is returned to authenticated browsers; the private key stays
# server-side and must never be exposed through Vite/client environment values.
# VAPID_PUBLIC_KEY=CHANGE_ME
# VAPID_PRIVATE_KEY=CHANGE_ME
# VAPID_SUBJECT=mailto:ops@example.com

# Warehouse Admin package label queue. Renderer yalnız ortak dsdst-internal Docker ağındadır.
# LABEL_RENDERER_URL=http://warehouse-label-renderer:3010
# LABEL_RENDERER_API_KEY=CHANGE_ME_shared_renderer_secret
# WAREHOUSE_PRINTER_NAME=ZEBRA_ZD421
# WAREHOUSE_CLAIM_LEASE_SECONDS=90
# WAREHOUSE_PRINT_WORKER_INTERVAL_MS=2000
# WAREHOUSE_PRINT_DRY_RUN=false
# CUPS_SERVER=host.docker.internal:631


# ── Database ──────────────────────────────────────────────────────────────────

# Absolute path to the SQLite database file.
# Docker default: /data/dsdst_panel.db  (mounted as a named volume)
# Local default:  <project-root>/dsdst_panel.db  (omit to use default)
# DB_PATH=/data/dsdst_panel.db

# Automatic backup archive directory.
# Docker default: /backups
# BACKUP_DIR=/backups

# docker-compose volume sources. Set absolute host paths to keep data visible
# outside Docker's named-volume storage.
# PANEL_DATA_DIR=/opt/dsdst-panel/data
# PANEL_UPLOADS_DIR=/opt/dsdst-panel/uploads
# PANEL_BACKUP_DIR=/opt/dsdst-panel/backups

# ── Cloud backup upload (Cloudflare R2 / rclone) ─────────────────────────────

# Enables uploading each managed backup archive to Cloudflare R2 after it is
# written locally. Local backups remain the source of truth if cloud upload fails.
# CLOUD_BACKUP_ENABLED=true
# CLOUD_BACKUP_PROVIDER=cloudflare-r2
# CLOUD_BACKUP_RCLONE_REMOTE=dsdstr2:dsdst-panel-backups
# CLOUD_BACKUP_PREFIX=production
# CLOUD_BACKUP_RETENTION_DAYS=30
# CLOUD_BACKUP_TIMEOUT_SECONDS=900

# rclone remote config through environment variables. Keep these in .env only.
# RCLONE_CONFIG_DSDSTR2_TYPE=s3
# RCLONE_CONFIG_DSDSTR2_PROVIDER=Cloudflare
# RCLONE_CONFIG_DSDSTR2_ACCESS_KEY_ID=your_r2_access_key_id
# RCLONE_CONFIG_DSDSTR2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# RCLONE_CONFIG_DSDSTR2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# ── Network / CORS ────────────────────────────────────────────────────────────

# Public URL of this app (used for self-referential links, OAuth callbacks).
APP_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins.
# Leave empty (or omit) to allow all origins — safe behind a Cloudflare Tunnel
# or private network. Restrict this in production if exposed publicly.
# ALLOWED_ORIGINS=https://panel.yourdomain.com,https://yourdomain.com


# ── Optional integrations ─────────────────────────────────────────────────────

# Verified Geliver SDK transport. All three values are required to enable it;
# otherwise the carrier gateway remains fail-closed. The SDK is configured with
# zero automatic retries for create/accept side effects.
# GELIVER_TOKEN=CHANGE_ME
# GELIVER_SENDER_ADDRESS_ID=geliver_sender_address_id
# GELIVER_SOURCE_IDENTIFIER=https://your-store.example
# GELIVER_TIMEOUT_MS=20000
# GELIVER_API_BASE_URL=https://api.geliver.io/api/v1

# Google Gemini AI API key — used for AI-assisted features.
# GEMINI_API_KEY=AIza...
